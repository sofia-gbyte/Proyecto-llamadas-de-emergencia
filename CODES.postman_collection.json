        {
          "name": "Iniciar sesión móvil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token && data.mfaSetupRequired) pm.collectionVariables.set('enrollmentToken', data.token);",
                  "  if (data.token && !data.mfaSetupRequired) pm.collectionVariables.set('mobileToken', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"captchaToken\": \"{{captchaToken}}\",\n  \"totpCode\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/mobile/login",
            "description": "Elimina totpCode si la cuenta aún no tiene MFA configurado. Si la respuesta incluye mfaSetupRequired=true, continúa con las solicitudes de inscripción TOTP."
          },
          "response": [],
          "auth": {
            "type": "noauth"
          }
        },
        {
          "name": "Preparar inscripción TOTP móvil",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/mobile/totp/setup",
            "description": "Usa el enrollmentToken generado por el inicio de sesión móvil cuando se requiere configurar MFA. Añade el secreto u otpauthUri a una aplicación autenticadora."
          },
          "response": [],
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{enrollmentToken}}",
                "type": "string"
              }
            ]
          }
        },
        {
          "name": "Verificar inscripción TOTP móvil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('mobileToken', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/mobile/totp/verify-setup"
          },
          "response": [],
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{enrollmentToken}}",
                "type": "string"
              }
            ]
