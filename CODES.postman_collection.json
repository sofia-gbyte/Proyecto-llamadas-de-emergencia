{
  "info": {
    "_postman_id": "bc4b39eb-261b-46c9-85b2-1c4f884ab6e1",
    "name": "CODES API",
    "description": "Colección para probar la API REST local de CODES. Inicia la aplicación y usa http://127.0.0.1:8000 como baseUrl. Completa username/password con una cuenta existente. Si ALTCHA está habilitado, solicita un desafío en CAPTCHA, resuélvelo con el componente ALTCHA de la aplicación y pega el token en captchaToken antes de iniciar sesión o registrarte. Las rutas administrativas y de operadores requieren el rol correspondiente. La API está pensada para uso local; no expongas el puerto a Internet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
