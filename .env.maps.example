# Set to a regional or country OSM .pbf extract before importing.
OSM_PBF_FILE=./map-data/chile-latest.osm.pbf
OSM_DATA_DIR=./map-data

# Tune import parallelism for the host.
TILE_THREADS=4
NOMINATIM_THREADS=4

# Replace with a long random value before starting Nominatim.
MAPS_NOMINATIM_PASSWORD=replace-with-a-long-random-password

# After importing and starting all map services, uncomment and adjust these
# CODES endpoints. Until then, CODES keeps its current provider defaults.
# CODES_MAP_TILES_URL=http://localhost:8081/tile/{z}/{x}/{y}.png
# CODES_ROUTING_URL=http://localhost:5000
# CODES_NOMINATIM_BASE_URL=http://127.0.0.1:8082
# CODES_PHOTON_BASE_URL=disabled
# CODES_GEOCODER_CENTER_LAT=-33.4489
# CODES_GEOCODER_CENTER_LNG=-70.6693
# CODES_GEOCODER_RADIUS_KM=30
# CODES_GEOCODER_USER_AGENT=CODES/1.0 contacto-operaciones@localhost
# CODES_ASR_WEBSOCKET_URL=ws://localhost:6006
